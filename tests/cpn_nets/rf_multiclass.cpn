        <var id="ID1000158">
          <type>
            <id>PROB</id>
          </type>
          <id>vp0</id>
          <id>vp1</id>
          <id>vp2</id>
          <id>vp3</id>
          <layout>var vp0, vp1, vp2, vp3 : PROB;</layout>
        </var>
        <ml id="ID1000159">fun vadd (xs, ys) = ListPair.map (fn (a:real, b:real) =&gt; a + b) (xs, ys);</ml>
        <ml id="ID1000160">fun vsum ([] : real list list) = []
  | vsum (h::t) = List.foldl vadd h t;</ml>
        <ml id="ID1000161">fun argmax (nil : real list) = 0
  | argmax (h::t) =
      let fun go (_, bi, _, []) = bi
            | go (i, bi, bv, (x:real)::xs) =
                if x &gt; bv then go (i+1, i, x, xs)
                          else go (i+1, bi, bv, xs)
      in go (1, 0, h, t) end;</ml>
        <ml id="ID1000162">fun allzero (xs : real list) =
      List.all (fn x =&gt; x &lt;= 0.0 andalso x &gt;= 0.0) xs;</ml>
        <ml id="ID1000163">fun decide (xs : real list) =
      if allzero xs then 0 else argmax xs;</ml>
      </block>
